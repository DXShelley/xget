  {
    "id": "claude-web",
    "alias": "claude-web",
    "mirrorHost": "claude.fast.dxshelley.fun",
    "upstreamOrigin": "https://claude.com",
    "adapter": "configured",
    "allowedMethods": ["GET", "HEAD", "POST"],
    "proxyPolicy": { "paths": "all", "timeoutSeconds": 20, "maxRetries": 1 },
    "browserMode": "isolated-origin",
    "browserCapabilities": {
      "forwardCredentials": false,
      "oauth": false,
      "rewriteSameOriginRedirects": true,
      "serviceWorker": false,
      "webSocket": false
    }
  },
